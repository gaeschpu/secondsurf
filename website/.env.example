# Copy the secrets to .dev.vars for local testing. On the live site, set everything in
# Cloudflare: Workers & Pages > secondsurf > Settings > Variables and Secrets. Never commit real values.

# Public, needed when the site is built (Variable, not Secret). Without it, forms are hidden on the live site.
PUBLIC_TURNSTILE_SITE_KEY=

# Forms
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=

# Dashboard at /admin/
ADMIN_PASSWORD=
SESSION_SECRET=
GITHUB_TOKEN=
# The "Fill in with AI" button needs no key: add a Workers AI binding named AI
# (Settings > Bindings > Add > Workers AI). Free up to a daily allowance.
