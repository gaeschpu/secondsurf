---
// Layout for terms, privacy and imprint. While OWNER.legalReviewed is false (src/settings/site.json), a review note shows in
// local development only (astro dev), never on the live site.
import Base from '../layouts/Base.astro';
import { useT, type Lang } from '../i18n';
import { OWNER } from '../config';

interface Props {
	lang: Lang;
	title: string;
	description: string;
}
const { lang, title, description } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} title={title} description={description}>
	<div class="container">
		<header class="page-head">
			<h1>{title}</h1>
		</header>
		{import.meta.env.DEV && !OWNER.legalReviewed && <p class="template card"><span class="todo">TODO</span> {t('legal.template')}</p>}
		<div class="prose">
			<slot />
		</div>
	</div>
</Base>

<style>
	.template {
		margin-bottom: 2rem;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--sand);
	}
</style>
