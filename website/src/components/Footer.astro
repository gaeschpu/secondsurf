---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';
import { l, url, useT, type Lang } from '../i18n';
import { SEASONS, SITE, SOCIALS } from '../config';
import { categoriesInStock } from '../lib/products';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const hasNews = (await getCollection('news')).length > 0;
// Only categories with available pieces (src/lib/products.ts).
const stocked = await categoriesInStock();

const columns = [
	{
		title: t('footer.shop'),
		links: [
			{ href: '/new/', label: t('nav.new') },
			{ href: '/shop/', label: t('nav.shopAll') },
			{ href: '/auctions/', label: t('nav.auctions') },
			...SEASONS.map((s) => ({ href: `/season/${s.id}/`, label: l(s.label, lang) })),
			...stocked.slice(0, 6).map((c) => ({ href: `/shop/${c.id}/`, label: l(c.label, lang) })),
		],
	},
	{
		title: t('footer.sell'),
		links: [
			{ href: '/sell/', label: t('nav.sell') },
		],
	},
	{
		title: t('footer.info'),
		links: [
			{ href: '/about/', label: t('nav.about') },
			...(hasNews ? [{ href: '/news/', label: t('news.title') }] : []),
			{ href: '/contact/', label: t('nav.contact') },
			{ href: '/returns/', label: t('returns.title') },
			{ href: '/terms/', label: t('legal.terms') },
			{ href: '/privacy/', label: t('legal.privacy') },
			{ href: '/imprint/', label: t('legal.imprint') },
		],
	},
];
---

<footer class="site-footer">
	<div class="container-wide cols">
		<div class="brand-col">
			<p class="name"><Logo size={38} /> {SITE.name}</p>
			<p class="made">{t('footer.made')}</p>
			<ul class="social">
				{
					SOCIALS.map((s) => (
						<li>
							<a href={s.href} rel="noopener" target="_blank">
								<Icon name={s.icon} size={20} label={s.label} />
							</a>
						</li>
					))
				}
				<li>
					<a href={url(lang, '/contact/')}><Icon name="mail" size={20} label={t('nav.contact')} /></a>
				</li>
			</ul>
			<!-- Shown by PwaSupport.astro only where the browser can install the app (Android/Chrome, iPhone Safari). -->
			<button type="button" class="app-button" data-pwa-open hidden>
				{{ de: 'App auf den Home-Bildschirm', fr: 'App sur l’écran d’accueil', it: 'App sulla schermata Home', en: 'Add app to home screen' }[lang]}
			</button>
		</div>
		{
			columns.map((col) => (
				<nav aria-label={col.title}>
					<h2>{col.title}</h2>
					<ul>
						{col.links.map((link) => (
							<li>
								<a href={url(lang, link.href)}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="container-wide bottom">
		<p>© {year} {SITE.name} · {t('shop.priceNote')} · <a class="admin-link" href="/admin/" rel="nofollow">Admin</a></p>
	</div>
</footer>

<style>
	/* Navy footer with light text, like the top bar. */
	.site-footer {
		background: var(--navy);
		color: var(--on-navy);
		font-size: var(--step--1);
	}
	.made {
		color: color-mix(in srgb, var(--on-navy) 75%, transparent);
	}
	.site-footer :global(a) {
		color: var(--on-navy);
	}
	.cols {
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: 2rem;
		padding-block: 2.5rem 1.5rem;
	}
	.name {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 800;
		text-transform: uppercase;
		color: var(--on-navy);
	}
	h2 {
		margin-bottom: 0.6rem;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	ul {
		padding: 0;
		list-style: none;
	}
	nav li + li {
		margin-top: 0.3rem;
	}
	nav a {
		color: color-mix(in srgb, var(--on-navy) 78%, transparent);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--on-navy);
		text-decoration: underline;
	}
	.social {
		display: flex;
		gap: 0.25rem;
		margin-top: 0.75rem;
	}
	.social a {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-sm);
		color: color-mix(in srgb, var(--on-navy) 75%, transparent);
	}
	.social a:hover {
		color: var(--accent);
		background: var(--bg);
	}
	.app-button {
		margin-top: 1rem;
		min-height: 2.6rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--on-navy);
		background: none;
		color: var(--on-navy);
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.app-button:hover {
		background: var(--on-navy);
		color: var(--navy);
	}
	.app-button[hidden] {
		display: none;
	}
	.bottom {
		padding-block: 1rem 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--on-navy) 18%, transparent);
		color: color-mix(in srgb, var(--on-navy) 70%, transparent);
	}
	@media (max-width: 48rem) {
		.cols {
			grid-template-columns: 1fr 1fr;
		}
		.brand-col {
			grid-column: 1 / -1;
		}
	}
</style>
