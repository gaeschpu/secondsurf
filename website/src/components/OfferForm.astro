---
// "Preis vorschlagen" on a product page: a logged-in customer offers a price (at most 35 % below),
// sent to /api/account/offer (functions/_lib/offer-create.ts). Logged out, the button shows a link to the login,
// which comes back here afterwards. Hidden on the live site until PUBLIC_TURNSTILE_SITE_KEY is set, like the other forms.
import Icon from './Icon.astro';
import { chf, url, useT, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	id: string;
	price: number;
}

const { lang, id, price } = Astro.props;
const t = useT(lang);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const show = Boolean(siteKey) || import.meta.env.DEV;
// Same rule as the server (functions/_lib/offers.ts): at most 35 % below, rounded up to whole francs.
const minimum = Math.ceil(price * 0.65);
const minText = chf(minimum);
---

{
	show && (
		<details class="offer">
			<summary class="btn btn-ghost">{t('offer.button')}</summary>
			<form
				class="offer-form"
				novalidate
				data-min={minimum}
				data-price={price}
				data-sent={t('offer.sent')}
				data-error={t('contact.error')}
				data-sending={t('contact.sending')}
				data-required={t('form.required')}
				data-too-low={t('offer.tooLow').replace('{min}', minText)}
				data-not-lower={t('offer.notLower')}
				data-sold={t('offer.sold')}
				data-too-many={t('offer.tooMany')}
			>
				<p class="small muted">{t('offer.intro').replace('{min}', minText)}</p>
				<input type="hidden" name="id" value={id} />
				<input type="hidden" name="lang" value={lang} />
				<label>
					{t('offer.amount')}
					<input name="amount" type="number" inputmode="decimal" min={minimum} max={price - 1} step="1" required placeholder={String(minimum)} />
				</label>
				<label>
					{t('offer.messageOptional')}
					<textarea name="message" rows="2" maxlength="1000" />
				</label>
				<p class="small muted">
					{t('form.privacyLabel')}: <a href={url(lang, '/privacy/')}>{t('legal.privacy')}</a>
				</p>
				<button class="btn" type="submit">
					{t('offer.send')}
				</button>
				<p class="status small" role="status" aria-live="polite" />
			</form>
		</details>
	)
}
{
	show && (
		<dialog class="offer-login" aria-labelledby="offer-login-text" tabindex="-1">
			<button type="button" class="close" aria-label={t('offer.close')} data-close>
				<Icon name="close" size={20} />
			</button>
			<p id="offer-login-text">{t('offer.loginNeeded')}</p>
			<a class="btn" href={url(lang, '/account/')} data-login>
				{t('offer.loginButton')}
			</a>
		</dialog>
	)
}

<script>
	import { api, ApiError, seemsLoggedIn } from '../scripts/account';

	for (const details of document.querySelectorAll<HTMLDetailsElement>('details.offer')) {
		const form = details.querySelector<HTMLFormElement>('.offer-form')!;
		const login = document.querySelector<HTMLDialogElement>('dialog.offer-login')!;
		const status = form.querySelector<HTMLElement>('.status')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const say = (text: string) => (status.textContent = text);

		// The login button comes back to this piece afterwards.
		const loginLink = login.querySelector<HTMLAnchorElement>('[data-login]')!;
		loginLink.href += `?back=${encodeURIComponent(location.pathname)}`;

		// Logged out, the button opens a popup in the middle of the screen instead of the form.
		const showLogin = () => {
			details.open = false;
			login.showModal();
			// Focus the box itself, not the x: Safari would draw a focus ring around the x right away.
			login.focus();
		};
		details.querySelector('summary')!.addEventListener('click', (event) => {
			if (details.open || seemsLoggedIn()) return;
			event.preventDefault();
			showLogin();
		});
		login.querySelector('[data-close]')!.addEventListener('click', () => login.close());
		// A tap on the dark background closes it too.
		login.addEventListener('click', (event) => {
			if (event.target === login) login.close();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			say('');
			const d = form.dataset;
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			const amount = Number(data.amount);
			if (!data.amount) return say(d.required!);
			if (amount < Number(d.min)) return say(d.tooLow!);
			if (amount >= Number(d.price)) return say(d.notLower!);

			button.disabled = true;
			say(d.sending!);
			try {
				await api('offer', 'POST', { ...data, amount });
				say(d.sent!);
				form.reset();
			} catch (error) {
				// The login ran out or was ended on another device.
				if ((error as ApiError).status === 401) return showLogin();
				const messages: Record<string, string | undefined> = { tooLow: d.tooLow, notLower: d.notLower, sold: d.sold, tooMany: d.tooMany };
				say(messages[(error as ApiError).code] ?? d.error!);
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.offer {
		margin-top: 1rem;
	}
	.offer > summary {
		list-style: none;
		cursor: pointer;
	}
	.offer > summary::-webkit-details-marker {
		display: none;
	}
	.offer-form {
		display: grid;
		gap: 0.85rem;
		margin-top: 1rem;
		padding: 1rem;
		border: 1px solid var(--line, rgba(0, 0, 0, 0.12));
		border-radius: var(--radius-sm);
	}
	.offer-form label {
		display: grid;
		gap: 0.3rem;
		font-weight: 600;
		font-size: var(--step--1);
	}
	.offer-form input,
	.offer-form textarea {
		font: inherit;
		font-weight: 400;
	}
	/* In the middle of the screen (the global reset removes the browser's own centring). */
	.offer-login {
		position: fixed;
		inset: 0;
		margin: auto;
		height: fit-content;
		width: min(calc(100vw - 2rem), 26rem);
		padding: 2.75rem 2rem 2rem;
		border: 0;
		border-radius: 0;
		background: var(--bg-raised);
		color: var(--ink);
		box-shadow: var(--shadow);
		text-align: center;
	}
	.offer-login[open] {
		display: grid;
		justify-items: center;
		gap: 1.25rem;
	}
	.offer-login:focus {
		outline: none;
	}
	.offer-login::backdrop {
		background: rgb(0 0 0 / 0.5);
	}
	.offer-login p {
		font-size: var(--step-1);
		font-weight: 600;
		line-height: 1.35;
	}
	/* Same square, bold look as the buttons on the product page. */
	.offer-login .btn {
		justify-content: center;
		width: 100%;
		min-height: 3.2rem;
		padding: 0.85rem 1.5rem;
		border-color: var(--ink);
		border-radius: 0;
		background: var(--ink);
		color: var(--bg);
		font-size: var(--step-0);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.offer-login .btn:hover {
		border-color: var(--ink-soft);
		background: var(--ink-soft);
		color: var(--bg);
	}
	.offer-login .close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		background: none;
		color: var(--ink-soft);
		cursor: pointer;
	}
	.status:empty {
		display: none;
	}
</style>
