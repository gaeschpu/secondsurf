---
// "Preis vorschlagen" on a product page: the customer offers a price (at most 35 % below), sent to functions/api/offers.
// Hidden on the live site until PUBLIC_TURNSTILE_SITE_KEY is set, like the other forms.
import { chf, url, useT, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	id: string;
	price: number;
}

const { lang, id, price } = Astro.props;
const t = useT(lang);
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const show = Boolean(siteKey) || import.meta.env.DEV;
// Same rule as the server (functions/_lib/offers.ts): at most 35 % below, rounded up to whole francs.
const minimum = Math.ceil(price * 0.65);
const minText = chf(minimum);
---

{
	show && (
		<details class="offer">
			<summary class="btn btn-ghost">{t('offer.button')}</summary>
			<form
				class="offer-form"
				novalidate
				data-min={minimum}
				data-price={price}
				data-sent={t('offer.sent')}
				data-error={t('contact.error')}
				data-sending={t('contact.sending')}
				data-captcha={t('form.captcha')}
				data-required={t('form.required')}
				data-email={t('form.email')}
				data-too-low={t('offer.tooLow').replace('{min}', minText)}
				data-not-lower={t('offer.notLower')}
				data-sold={t('offer.sold')}
				data-too-many={t('offer.tooMany')}
			>
				<p class="small muted">{t('offer.intro').replace('{min}', minText)}</p>
				<input type="hidden" name="id" value={id} />
				<input type="hidden" name="lang" value={lang} />
				<label class="hp" aria-hidden="true">
					Website <input name="botcheck" tabindex="-1" autocomplete="off" />
				</label>
				<label>
					{t('offer.amount')}
					<input name="amount" type="number" inputmode="decimal" min={minimum} max={price - 1} step="1" required placeholder={String(minimum)} />
				</label>
				<div class="row">
					<label>
						{t('contact.name')}
						<input name="name" autocomplete="name" maxlength="120" required />
					</label>
					<label>
						{t('contact.email')}
						<input name="email" type="email" autocomplete="email" maxlength="200" required />
					</label>
				</div>
				<label>
					{t('offer.messageOptional')}
					<textarea name="message" rows="2" maxlength="1000" />
				</label>
				<p class="small muted">
					{t('form.privacyLabel')}: <a href={url(lang, '/privacy/')}>{t('legal.privacy')}</a>
				</p>
				{
					siteKey && (
						<>
							<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
							<div class="cf-turnstile" data-sitekey={siteKey} data-language={lang} data-theme="light" />
						</>
					)
				}
				<button class="btn" type="submit" disabled={!siteKey}>
					{t('offer.send')}
				</button>
				<p class="status small" role="status" aria-live="polite" />
			</form>
		</details>
	)
}

<script>
	declare const turnstile: { reset: () => void } | undefined;

	for (const form of document.querySelectorAll<HTMLFormElement>('.offer-form')) {
		const status = form.querySelector<HTMLElement>('.status')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const say = (text: string) => (status.textContent = text);

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			say('');
			const d = form.dataset;
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			const amount = Number(data.amount);
			if (!data.amount || !data.name.trim() || !data.email.trim()) return say(d.required!);
			if (!form.querySelector<HTMLInputElement>('input[name=email]')!.checkValidity()) return say(d.email!);
			if (amount < Number(d.min)) return say(d.tooLow!);
			if (amount >= Number(d.price)) return say(d.notLower!);
			if (!data['cf-turnstile-response']) return say(d.captcha!);

			button.disabled = true;
			say(d.sending!);
			try {
				const res = await fetch('/api/offers', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ ...data, amount }),
				});
				const json = (await res.json().catch(() => ({}))) as { error?: string; link?: string };
				const messages: Record<string, string | undefined> = {
					captcha: d.captcha,
					tooLow: d.tooLow,
					notLower: d.notLower,
					sold: d.sold,
					tooMany: d.tooMany,
				};
				if (!res.ok) return say(messages[json.error ?? ''] ?? d.error!);
				say(d.sent!);
				form.reset();
			} catch {
				say(d.error!);
			} finally {
				button.disabled = false;
				// A token only works once.
				if (typeof turnstile !== 'undefined') turnstile.reset();
			}
		});
	}
</script>

<style>
	.offer {
		margin-top: 1rem;
	}
	.offer > summary {
		list-style: none;
		cursor: pointer;
	}
	.offer > summary::-webkit-details-marker {
		display: none;
	}
	.offer-form {
		display: grid;
		gap: 0.85rem;
		margin-top: 1rem;
		padding: 1rem;
		border: 1px solid var(--line, rgba(0, 0, 0, 0.12));
		border-radius: var(--radius-sm);
	}
	.offer-form label {
		display: grid;
		gap: 0.3rem;
		font-weight: 600;
		font-size: var(--step--1);
	}
	.offer-form input,
	.offer-form textarea {
		font: inherit;
		font-weight: 400;
	}
	.row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
		gap: 0.85rem;
	}
	.hp {
		position: absolute;
		left: -9999px;
	}
	.status:empty {
		display: none;
	}
</style>
