---
// Row of category chips above the shop grid.
import { l, url, useT, type Lang } from '../i18n';
import { CATEGORIES } from '../config';

interface Props {
	lang: Lang;
	current?: string;
}
const { lang, current } = Astro.props;
const t = useT(lang);
---

<nav class="cat-nav" aria-label={t('shop.categories')}>
	<ul>
		<li><a href={url(lang, '/shop/')} aria-current={!current ? 'page' : undefined}>{t('nav.shopAll')}</a></li>
		{
			CATEGORIES.map((c) => (
				<li>
					<a href={url(lang, `/shop/${c.id}/`)} aria-current={current === c.id ? 'page' : undefined}>
						{l(c.label, lang)}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.cat-nav {
		margin-bottom: 1.25rem;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		padding: 0.4em 0.95em;
		border-radius: 999px;
		background: var(--sand-tint);
		color: var(--ink);
		font-size: var(--step--1);
		font-weight: 600;
		white-space: nowrap;
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	a[aria-current='page'] {
		background: var(--ink);
		color: var(--bg);
	}
</style>
