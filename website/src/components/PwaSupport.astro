---
// App support on every page (in src/layouts/Base.astro):
//   - registers the service worker /sw.js (src/pages/sw.js.ts), only in the built site
//   - "new version" toast when a new deploy has taken over, with a reload button
//   - "install the app" hint on phones: Android/Chrome with the browser's install dialog (beforeinstallprompt),
//     iPhone/iPad Safari with a short instruction. At most once in 30 days, never when already installed, never during
//     a purchase (cart, checkout return, auction or offer payment, parcel check). The admin dashboard doesn't use this
//     layout, so it never shows there.
import { type Lang } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const text = {
	de: { update: 'Neue Version verfügbar', reload: 'Neu laden', install: 'secondsurf als App', installText: 'Leg den Shop auf deinen Home-Bildschirm.', installButton: 'Installieren', ios: 'Tippe unten auf «Teilen» und dann auf «Zum Home-Bildschirm».', close: 'Schliessen' },
	fr: { update: 'Nouvelle version disponible', reload: 'Recharger', install: 'secondsurf en app', installText: 'Ajoute la boutique à ton écran d’accueil.', installButton: 'Installer', ios: 'Touche «Partager» en bas, puis «Sur l’écran d’accueil».', close: 'Fermer' },
	it: { update: 'Nuova versione disponibile', reload: 'Ricarica', install: 'secondsurf come app', installText: 'Metti il negozio sulla schermata Home.', installButton: 'Installa', ios: 'Tocca «Condividi» in basso e poi «Aggiungi alla schermata Home».', close: 'Chiudi' },
	en: { update: 'New version available', reload: 'Reload', install: 'secondsurf as an app', installText: 'Put the shop on your home screen.', installButton: 'Install', ios: 'Tap “Share” below, then “Add to Home Screen”.', close: 'Close' },
}[lang];
const register = import.meta.env.PROD;
---

<div class="pwa-toast" data-pwa-update role="status" hidden>
	<span>{text.update}</span>
	<button type="button" class="pwa-btn" data-pwa-reload>{text.reload}</button>
</div>

<aside class="pwa-hint" data-pwa-hint aria-label={text.install} hidden>
	<img src="/icons/icon-192.png" alt="" width="44" height="44" />
	<div class="pwa-hint-text">
		<strong>{text.install}</strong>
		<span data-pwa-android hidden>{text.installText}</span>
		<span data-pwa-ios hidden>{text.ios}</span>
	</div>
	<button type="button" class="pwa-btn" data-pwa-install hidden>{text.installButton}</button>
	<button type="button" class="pwa-close" data-pwa-close aria-label={text.close}>×</button>
</aside>

<span data-pwa-register={register ? '1' : ''} hidden></span>

<script>
	type InstallEvent = Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> };

	const KEY = 'install-hint';
	const DAYS = 30;
	const hint = document.querySelector<HTMLElement>('[data-pwa-hint]')!;
	const toast = document.querySelector<HTMLElement>('[data-pwa-update]')!;
	const path = location.pathname.replace(/^\/(fr|it|en)(?=\/)/, '');
	// No hint during a purchase or on personal pages.
	const quiet = /^\/(cart|thanks|offer|auction|parcel|account|tracking|offline)\//.test(path);
	const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
	const phone = matchMedia('(pointer: coarse)').matches && matchMedia('(max-width: 820px)').matches;

	const seenRecently = () => {
		try {
			const at = Number(localStorage.getItem(KEY) ?? 0);
			return Date.now() - at < DAYS * 86400_000;
		} catch {
			return true; // without storage the hint would come back on every page: better not at all
		}
	};
	const remember = () => {
		try {
			localStorage.setItem(KEY, String(Date.now()));
		} catch {}
	};
	// Not while the cookie notice is still open (both sit at the bottom).
	const cookieNoticeOpen = () => {
		try {
			return !localStorage.getItem('cookie-notice');
		} catch {
			return false;
		}
	};
	const openHint = (kind: 'android' | 'ios') => {
		hint.querySelector<HTMLElement>(`[data-pwa-${kind}]`)!.hidden = false;
		if (kind === 'android') hint.querySelector<HTMLElement>('[data-pwa-install]')!.hidden = false;
		hint.hidden = false;
	};
	const showHint = (kind: 'android' | 'ios') => {
		if (quiet || standalone || !phone || seenRecently() || cookieNoticeOpen()) return;
		openHint(kind);
		remember();
	};
	hint.querySelector('[data-pwa-close]')!.addEventListener('click', () => (hint.hidden = true));

	// Footer button "App auf den Home-Bildschirm": only where installing is possible and not yet installed.
	const appButtons = document.querySelectorAll<HTMLElement>('[data-pwa-open]');
	const showAppButtons = () => appButtons.forEach((b) => (b.hidden = standalone));

	// Android / Chrome: the browser says when the app can be installed; the button then opens its install dialog.
	let deferred: InstallEvent | null = null;
	const install = async () => {
		hint.hidden = true;
		if (!deferred) return;
		await deferred.prompt();
		deferred = null;
	};
	window.addEventListener('beforeinstallprompt', (event) => {
		event.preventDefault();
		deferred = event as InstallEvent;
		showAppButtons();
		setTimeout(() => showHint('android'), 8000);
	});
	hint.querySelector('[data-pwa-install]')!.addEventListener('click', install);
	window.addEventListener('appinstalled', () => {
		hint.hidden = true;
		appButtons.forEach((b) => (b.hidden = true));
	});

	// iPhone / iPad Safari: Apple doesn't let a site add itself, so the button shows the two taps
	// (not in Chrome, Firefox etc. on iOS, which can't do it).
	const ua = navigator.userAgent;
	const iosSafari = /iPhone|iPad|iPod/.test(ua) && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS/.test(ua);
	if (iosSafari) {
		showAppButtons();
		setTimeout(() => showHint('ios'), 8000);
	}
	appButtons.forEach((b) =>
		b.addEventListener('click', () => {
			if (deferred) install();
			else if (iosSafari) openHint('ios');
		}),
	);

	// Service worker: register, and show the toast when a new version took over this page.
	if (document.querySelector('[data-pwa-register="1"]') && 'serviceWorker' in navigator) {
		const hadController = Boolean(navigator.serviceWorker.controller);
		navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
		navigator.serviceWorker.addEventListener('controllerchange', () => {
			// The first install also fires this; only an update is worth a message.
			if (hadController) toast.hidden = false;
		});
		toast.querySelector('[data-pwa-reload]')!.addEventListener('click', () => location.reload());
	}
</script>

<style>
	.pwa-toast,
	.pwa-hint {
		position: fixed;
		left: 50%;
		bottom: max(1rem, env(safe-area-inset-bottom));
		z-index: 90;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: min(calc(100% - 2rem), 30rem);
		padding: 0.75rem 0.9rem;
		background: var(--navy);
		color: var(--on-navy);
		box-shadow: var(--shadow);
	}
	.pwa-toast[hidden],
	.pwa-hint[hidden],
	.pwa-hint [hidden] {
		display: none;
	}
	.pwa-toast span {
		flex: 1;
		font-weight: 600;
	}
	.pwa-hint img {
		flex: none;
		border-radius: 10px;
	}
	.pwa-hint-text {
		display: grid;
		flex: 1;
		gap: 0.1rem;
		font-size: var(--step--1);
		line-height: 1.35;
	}
	.pwa-hint-text strong {
		font-family: var(--font-display);
		font-size: var(--step-0);
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}
	.pwa-btn {
		flex: none;
		min-height: 2.6rem;
		padding: 0.5rem 1rem;
		border: 0;
		background: var(--on-navy);
		color: var(--navy);
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.pwa-close {
		flex: none;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--on-navy);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
	}
</style>
