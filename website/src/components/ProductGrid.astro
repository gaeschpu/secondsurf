---
// Grid of product cards with an optional "Filter" button at the top right, above the last card of the first row.
// It opens a panel with everything to narrow down: categories (links to the category pages, if `categories` is set),
// brand, size and price. Brand, size and price filter without a page reload; only values that occur are offered.
// The choice is kept in the address (?brand=…&size=…&price=…), so a filtered link can be shared.
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import { chf, l, url, useT, type Lang } from '../i18n';
import { CATEGORIES, SIZES } from '../config';
import { categoriesInStock, type Product } from '../lib/products';

interface Props {
	lang: Lang;
	products: Product[];
	/** Show the filter button above the grid. */
	filter?: boolean;
	/** Also list the shop categories in the filter panel; the current one is marked. `''` = all pieces. */
	categories?: string;
}

const { lang, products, filter = false, categories } = Astro.props;
const t = useT(lang);

/** Price ranges in CHF: [from, up to and including]. */
const PRICE_RANGES = [
	{ id: 'u35', min: 0, max: 35 },
	{ id: '36-50', min: 35.01, max: 50 },
	{ id: '51-100', min: 50.01, max: 100 },
	{ id: 'o100', min: 100.01, max: Infinity },
] as const;
const priceLabel = (range: (typeof PRICE_RANGES)[number]) =>
	range.id === 'u35'
		? t('shop.priceUpTo').replace('{price}', chf(35))
		: range.id === 'o100'
			? t('shop.priceOver').replace('{price}', chf(100))
			: `CHF ${Math.ceil(range.min)}–${range.max}`;

const brands = [...new Set(products.map((p) => p.data.brand))].sort((a, b) => a.localeCompare(b, 'de'));
const sizes = SIZES.filter((s) => products.some((p) => p.data.size === s));
const prices = PRICE_RANGES.filter((r) => products.some((p) => p.data.price >= r.min && p.data.price <= r.max));

const groups = [
	{ key: 'brand', label: t('shop.brand'), options: brands.map((b) => ({ value: b, label: b })) },
	{ key: 'size', label: t('shop.size'), options: sizes.map((s) => ({ value: s, label: s })) },
	{ key: 'price', label: t('shop.price'), options: prices.map((r) => ({ value: r.id, label: priceLabel(r) })) },
].filter((group) => group.options.length > 1);

const showCategories = categories !== undefined;
// Only categories with available pieces, plus the one being shown (so its page still marks itself).
const stocked = new Set((await categoriesInStock()).map((c) => c.id));
const categoryLinks = CATEGORIES.filter((c) => stocked.has(c.id) || c.id === categories);
const showButton = filter && (groups.length > 0 || showCategories);
const panelId = `filter-panel-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="product-grid-wrap" data-ranges={JSON.stringify(PRICE_RANGES.map((r) => [r.id, r.min, r.max === Infinity ? null : r.max]))}>
	{
		showButton && (
			<div class="toolbar">
				<button type="button" class="filter-toggle" aria-expanded="false" aria-controls={panelId}>
					<Icon name="sliders" size={18} />
					{t('shop.filter')}
					<span class="count" hidden />
				</button>
				<div class="filter-panel" id={panelId} role="dialog" aria-label={t('shop.filter')} hidden>
					<div class="panel-head">
						<p class="panel-title">{t('shop.filter')}</p>
						<button type="button" class="panel-close" aria-label={t('offer.close')}>
							<Icon name="close" size={20} />
						</button>
					</div>
					{showCategories && (
						<nav class="filter" aria-label={t('shop.categories')}>
							<span class="label">{t('shop.categories')}</span>
							<div class="options">
								<a href={url(lang, '/shop/')} aria-current={categories === '' ? 'page' : undefined}>
									{t('nav.shopAll')}
								</a>
								{categoryLinks.map((c) => (
									<a href={url(lang, `/shop/${c.id}/`)} aria-current={categories === c.id ? 'page' : undefined}>
										{l(c.label, lang)}
									</a>
								))}
							</div>
						</nav>
					)}
					{groups.map((group) => (
						<div class="filter" role="group" aria-label={group.label} data-filter={group.key}>
							<span class="label">{group.label}</span>
							<div class="options">
								<button type="button" data-value="" aria-pressed="true">
									{t('shop.filterAll')}
								</button>
								{group.options.map((o) => (
									<button type="button" data-value={o.value} aria-pressed="false">
										{o.label}
									</button>
								))}
							</div>
						</div>
					))}
					<div class="panel-foot">
						<button type="button" class="reset" hidden>
							{t('shop.filterReset')}
						</button>
						<button type="button" class="show" data-label={t('shop.showResults')}>
							{t('shop.showResults').replace('{n}', String(products.length))}
						</button>
					</div>
				</div>
			</div>
		)
	}
	{
		products.length > 0 ? (
			<ul class="product-grid">
				{products.map((p) => (
					<ProductCard lang={lang} product={p} />
				))}
			</ul>
		) : (
			<p class="empty muted">{t('shop.empty')}</p>
		)
	}
	<p class="no-match muted" hidden>{t('shop.noMatch')}</p>
</div>

<script>
	type Key = 'brand' | 'size' | 'price';
	const KEYS: Key[] = ['brand', 'size', 'price'];

	document.querySelectorAll<HTMLElement>('.product-grid-wrap').forEach((wrap) => {
		const toggle = wrap.querySelector<HTMLButtonElement>('.filter-toggle');
		const panel = wrap.querySelector<HTMLElement>('.filter-panel');
		if (!toggle || !panel) return;
		const groups = [...wrap.querySelectorAll<HTMLElement>('.filter[data-filter]')];
		const items = [...wrap.querySelectorAll<HTMLElement>('.product')];
		const noMatch = wrap.querySelector<HTMLElement>('.no-match')!;
		const reset = wrap.querySelector<HTMLButtonElement>('.reset')!;
		const show = wrap.querySelector<HTMLButtonElement>('.show')!;
		const count = toggle.querySelector<HTMLElement>('.count')!;
		const ranges = new Map<string, [number, number | null]>(
			(JSON.parse(wrap.dataset.ranges!) as [string, number, number | null][]).map(([id, min, max]) => [id, [min, max]]),
		);
		const state: Record<Key, string> = { brand: '', size: '', price: '' };

		// Open and close the panel.
		const setOpen = (open: boolean) => {
			panel.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
			if (open) panel.querySelector<HTMLElement>('button, a')?.focus();
		};
		toggle.addEventListener('click', () => setOpen(panel.hidden !== false));
		panel.querySelector('.panel-close')!.addEventListener('click', () => {
			setOpen(false);
			toggle.focus();
		});
		show.addEventListener('click', () => setOpen(false));
		document.addEventListener('click', (event) => {
			if (!panel.hidden && !panel.contains(event.target as Node) && !toggle.contains(event.target as Node)) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !panel.hidden) {
				setOpen(false);
				toggle.focus();
			}
		});

		const matches = (item: HTMLElement) => {
			if (state.brand && item.dataset.brand !== state.brand) return false;
			if (state.size && item.dataset.size !== state.size) return false;
			if (state.price) {
				const [min, max] = ranges.get(state.price) ?? [0, null];
				const price = Number(item.dataset.price);
				if (price < min || (max !== null && price > max)) return false;
			}
			return true;
		};

		const apply = () => {
			let shown = 0;
			for (const item of items) {
				const match = matches(item);
				item.hidden = !match;
				if (match) shown++;
			}
			noMatch.hidden = shown > 0;
			for (const group of groups) {
				const key = group.dataset.filter as Key;
				group.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === state[key])));
			}
			const active = KEYS.filter((key) => state[key]).length;
			count.hidden = active === 0;
			count.textContent = String(active);
			reset.hidden = active === 0;
			show.textContent = show.dataset.label!.replace('{n}', String(shown));
			const u = new URL(location.href);
			for (const key of KEYS) {
				if (state[key]) u.searchParams.set(key, state[key]);
				else u.searchParams.delete(key);
			}
			history.replaceState(null, '', u);
		};

		for (const group of groups) {
			const key = group.dataset.filter as Key;
			const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
			buttons.forEach((b) =>
				b.addEventListener('click', () => {
					state[key] = b.dataset.value ?? '';
					apply();
				}),
			);
			// A shared link keeps its filters, as long as the value still exists.
			const initial = new URL(location.href).searchParams.get(key);
			if (initial && buttons.some((b) => b.dataset.value === initial)) state[key] = initial;
		}
		reset.addEventListener('click', () => {
			for (const key of KEYS) state[key] = '';
			apply();
		});
		if (KEYS.some((key) => state[key])) apply();
	});
</script>

<style>
	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(45%, 14rem), 1fr));
		gap: clamp(1rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem);
		padding: 0;
		list-style: none;
	}
	/* The button sits at the right edge, above the last card of the first row. */
	.toolbar {
		position: relative;
		display: flex;
		justify-content: flex-end;
		margin-bottom: 1rem;
	}
	.filter-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.55rem 1.1rem;
		border: 1.5px solid var(--ink);
		border-radius: 0;
		background: var(--bg-raised);
		color: var(--ink);
		font: inherit;
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.filter-toggle:hover,
	.filter-toggle[aria-expanded='true'] {
		background: var(--ink);
		color: var(--bg);
	}
	.count {
		display: inline-grid;
		place-items: center;
		min-width: 1.4rem;
		height: 1.4rem;
		padding: 0 0.3rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--on-accent);
		font-size: 0.75rem;
		letter-spacing: 0;
	}
	.count[hidden] {
		display: none;
	}
	.filter-panel {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		z-index: 40;
		display: grid;
		gap: 1.25rem;
		width: min(26rem, calc(100vw - 2 * var(--gutter)));
		max-height: min(75vh, 40rem);
		overflow: auto;
		padding: 1.25rem;
		border: 1.5px solid var(--ink);
		background: var(--bg-raised);
		box-shadow: var(--shadow);
	}
	.filter-panel[hidden] {
		display: none;
	}
	.panel-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.panel-title {
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.panel-close {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--ink-soft);
		cursor: pointer;
	}
	.filter {
		display: grid;
		gap: 0.5rem;
	}
	.filter .label {
		font-size: var(--step--1);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.options button,
	.options a {
		min-width: 2.75rem;
		padding: 0.35em 0.85em;
		border: 1.5px solid var(--line);
		border-radius: 999px;
		background: var(--bg);
		color: var(--ink);
		font-size: var(--step--1);
		font-weight: 600;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
	}
	.options button:hover,
	.options a:hover {
		border-color: var(--accent);
	}
	.options button[aria-pressed='true'],
	.options a[aria-current='page'] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}
	.panel-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding-top: 0.25rem;
		border-top: 1px solid var(--line);
	}
	.reset {
		padding: 0;
		border: 0;
		background: none;
		color: var(--accent);
		font: inherit;
		font-size: var(--step--1);
		text-decoration: underline;
		cursor: pointer;
	}
	.reset[hidden] {
		display: block;
		visibility: hidden;
	}
	.show {
		margin-left: auto;
		min-height: 2.75rem;
		padding: 0.6rem 1.2rem;
		border: 1.5px solid var(--ink);
		border-radius: 0;
		background: var(--ink);
		color: var(--bg);
		font: inherit;
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		cursor: pointer;
	}
	.empty,
	.no-match {
		padding-block: 2rem;
	}
</style>
