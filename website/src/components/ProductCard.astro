---
// One product tile, Jamdrobe style: photo (second photo on hover), BRAND + name, size, price.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { chf, l, url, useT, type Lang } from '../i18n';
import type { Product } from '../lib/products';

interface Props {
	lang: Lang;
	product: Product;
}

const { lang, product } = Astro.props;
const t = useT(lang);
const p = product.data;
const [first, second] = p.photos;
const name = l(p.title, lang);
---

<li class="product" data-size={p.size}>
	<a href={url(lang, `/item/${product.id}/`)} class:list={['card-link', { sold: p.sold }]}>
		<div class="media">
			{
				first ? (
					<>
						<Image src={first} alt={`${p.brand} ${name}`} widths={[360, 640]} sizes="(max-width: 40rem) 50vw, 18rem" class="photo" />
						{second && <Image src={second} alt="" widths={[360, 640]} sizes="(max-width: 40rem) 50vw, 18rem" class="photo hover" />}
					</>
				) : (
					<div class="photo placeholder" aria-hidden="true">
						<Icon name="shirt" size={44} />
					</div>
				)
			}
			{p.sold && <span class="badge">{t('shop.sold')}</span>}
			{p.draft && <span class="badge draft">DRAFT</span>}
		</div>
		<p class="title"><strong>{p.brand}</strong> {name}{p.staffPick && ' ★'}</p>
		<p class="meta">
			<span>{t('shop.size')} {p.size}</span>
			<span class="price">{chf(p.price)}</span>
		</p>
	</a>
</li>

<style>
	.card-link {
		display: block;
		color: var(--ink);
		text-decoration: none;
	}
	.card-link:hover {
		color: var(--ink);
	}
	.media {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--bg-sunken);
	}
	.photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			opacity 0.25s,
			transform 0.4s;
	}
	.photo.hover {
		opacity: 0;
	}
	.card-link:hover .photo.hover,
	.card-link:focus-visible .photo.hover {
		opacity: 1;
	}
	.card-link:hover .photo {
		transform: scale(1.03);
	}
	.placeholder {
		display: grid;
		place-items: center;
		color: var(--sand);
		background: var(--sand-tint);
	}
	.sold .photo {
		filter: grayscale(1);
		opacity: 0.55;
	}
	.badge {
		position: absolute;
		top: 0.6rem;
		left: 0.6rem;
		padding: 0.2em 0.7em;
		border-radius: 999px;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.badge.draft {
		left: auto;
		right: 0.6rem;
		background: #fde68a;
		color: #713f12;
	}
	.title {
		margin-top: 0.7rem;
		font-size: var(--step--1);
		line-height: 1.35;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.meta {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.25rem;
		font-size: var(--step--1);
		color: var(--ink-soft);
	}
	.price {
		font-weight: 700;
		color: var(--ink);
	}
</style>
