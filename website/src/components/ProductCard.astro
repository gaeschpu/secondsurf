---
// One product tile, Jamdrobe style: photos you can swipe through, BRAND + name, size, price.
// Swipe on phones; arrows on hover and dots on computers. The whole photo still links to the piece.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import WishButton from './WishButton.astro';
import { chf, l, url, useT, type Lang } from '../i18n';
import type { Product } from '../lib/products';
import { modelTag } from '../scripts/models';
import { auctionTexts } from '../i18n/auction';

interface Props {
	lang: Lang;
	product: Product;
}

const { lang, product } = Astro.props;
const t = useT(lang);
const p = product.data;
const photos = p.photos;
const name = l(p.title, lang);
const slider = photos.length > 1;
---

<li class="product" data-id={product.id} data-size={p.size} data-brand={p.brand} data-price={p.price}>
	<a href={url(lang, `/item/${product.id}/`)} class:list={['card-link', { sold: p.sold }]}>
		<div class="media">
			{
				photos.length > 0 ? (
					<div class="track" data-track>
						{photos.map((photo, i) => (
							<Image
								src={photo}
								alt={`${p.brand} ${name}, ${t('shop.size')} ${p.size} – ${t('shop.photo')} ${i + 1}`}
								widths={[360, 640]}
								sizes="(max-width: 40rem) 50vw, 18rem"
								loading={i === 0 ? undefined : 'lazy'}
								class="photo"
								data-model={modelTag(p.models, i)}
							/>
						))}
					</div>
				) : (
					<div class="photo placeholder" aria-hidden="true">
						<Icon name="shirt" size={44} />
					</div>
				)
			}
			{
				slider && (
					<span class="dots" aria-hidden="true">
						{photos.map((_, i) => (
							<span class:list={['dot', { on: i === 0 }]} />
						))}
					</span>
				)
			}
			{p.sold && <span class="badge">{t('shop.sold')}</span>}
			{p.draft && <span class="badge draft">DRAFT</span>}
			{/* Shown by the script below while the piece is being auctioned. */}
			{
				!p.sold && (
					<span
						class="badge auction"
						data-auction-badge
						data-auction={auctionTexts[lang].badge}
						data-reserved={auctionTexts[lang].reserved}
						data-sold={auctionTexts[lang].sold}
						hidden
					/>
				)
			}
		</div>
		<p class="title"><strong>{p.brand}</strong> {name}{p.staffPick && ' ★'}</p>
		<p class="meta">
			<span>{t('shop.size')} {p.size}</span>
			<span class="price">{chf(p.price)}</span>
		</p>
	</a>
	{
		slider && (
			<>
				<button type="button" class="nav prev" data-step="-1" aria-label={t('shop.prevPhoto')} hidden>
					<Icon name="chevronLeft" size={18} />
				</button>
				<button type="button" class="nav next" data-step="1" aria-label={t('shop.nextPhoto')}>
					<Icon name="chevronRight" size={18} />
				</button>
			</>
		)
	}
	{!p.sold && <WishButton lang={lang} id={product.id} class="card-wish" />}
</li>

<script>
	import { applyOrder, modelOrder } from '../scripts/models';

	// Auction state of each piece (one request for the whole page): "Auktion" while it runs, "Reserviert" while the winner
	// pays, and a piece paid through an auction leaves the list (the rebuild then marks it sold for good).
	const cards = document.querySelectorAll<HTMLElement>('.product [data-auction-badge]');
	if (cards.length)
		fetch('/api/auctions/states', { cache: 'no-store' })
			.then((res) => (res.ok ? res.json() : []))
			.then((list: { id: string; state: 'auction' | 'reserved' | 'sold' }[]) => {
				const states = new Map(list.map((a) => [a.id, a.state]));
				cards.forEach((badge) => {
					const card = badge.closest<HTMLElement>('.product')!;
					const state = states.get(card.dataset.id!);
					badge.hidden = !state;
					if (state) badge.textContent = badge.dataset[state] ?? '';
					badge.classList.toggle('reserved', state === 'reserved');
					card.classList.toggle('auction-sold', state === 'sold');
				});
			})
			.catch(() => {});

	// Arrows scroll the photo strip one photo at a time; the dots and arrows follow the scroll position (swipe too).
	for (const card of document.querySelectorAll<HTMLElement>('.product')) {
		const track = card.querySelector<HTMLElement>('[data-track]');
		// Models in the gender the customer chose come first (src/scripts/models.ts).
		const photos = track ? [...track.querySelectorAll<HTMLImageElement>('img')] : [];
		const order = modelOrder(photos.map((img) => img.dataset.model));
		if (order) {
			const first = photos[order[0]];
			[first.alt, photos[0].alt] = [photos[0].alt, first.alt];
			first.loading = 'eager';
			applyOrder(order, track);
		}
		const dots = [...card.querySelectorAll<HTMLElement>('.dot')];
		const prev = card.querySelector<HTMLButtonElement>('.nav.prev');
		const next = card.querySelector<HTMLButtonElement>('.nav.next');
		if (!track || dots.length < 2) continue;
		const index = () => Math.round(track.scrollLeft / track.clientWidth);
		const update = () => {
			const i = index();
			dots.forEach((dot, n) => dot.classList.toggle('on', n === i));
			if (prev) prev.hidden = i === 0;
			if (next) next.hidden = i === dots.length - 1;
		};
		for (const button of [prev, next]) {
			button?.addEventListener('click', () => {
				const i = Math.min(dots.length - 1, Math.max(0, index() + Number(button.dataset.step)));
				track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
			});
		}
		track.addEventListener('scroll', update, { passive: true });
	}
</script>

<style>
	.product {
		position: relative;
		/* Without this, the photo strip makes the grid column as wide as all photos side by side. */
		min-width: 0;
	}
	.product :global(.card-wish) {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
	}
	.card-link {
		display: block;
		color: var(--ink);
		text-decoration: none;
	}
	.card-link:hover {
		color: var(--ink);
	}
	.media {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--bg-sunken);
	}
	.track {
		display: flex;
		height: 100%;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.photo {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}
	.placeholder {
		display: grid;
		place-items: center;
		color: var(--sand);
		background: var(--sand-tint);
	}
	.sold .photo {
		filter: grayscale(1);
		opacity: 0.55;
	}
	.dots {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.55rem;
		display: flex;
		justify-content: center;
		gap: 0.3rem;
		pointer-events: none;
	}
	.dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.7);
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
		transition: background 0.2s;
	}
	.dot.on {
		background: var(--ink);
	}
	/* The arrows sit on top of the photo (outside the link, so clicking them doesn't open the piece). */
	.nav {
		position: absolute;
		top: 0;
		margin-top: calc((100% * 5 / 4) / 2 - 1rem);
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.9);
		color: var(--ink);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.2s;
	}
	.nav[hidden] {
		display: none;
	}
	.prev {
		left: 0.45rem;
	}
	.next {
		right: 0.45rem;
	}
	.product:hover .nav,
	.nav:focus-visible {
		opacity: 1;
	}
	/* Phones and tablets: swiping is enough, no arrows. */
	@media (hover: none) {
		.nav {
			display: none;
		}
	}
	.badge {
		position: absolute;
		top: 0.6rem;
		left: 0.6rem;
		padding: 0.2em 0.7em;
		border-radius: 999px;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.badge[hidden] {
		display: none;
	}
	.badge.auction {
		background: #b42318;
		color: #fff;
	}
	.badge.auction.reserved {
		background: var(--ink);
		color: var(--bg);
	}
	/* Sold through an auction: out of the list right away (the rebuild removes it for good). */
	:global(.product.auction-sold) {
		display: none !important;
	}
	.badge.draft {
		left: auto;
		right: 0.6rem;
		background: #fde68a;
		color: #713f12;
	}
	/* Title in its normal spelling; only the brand (first word, bold) in capitals. Long titles wrap. */
	.title {
		margin-top: 0.7rem;
		font-size: var(--step--1);
		line-height: 1.35;
		overflow-wrap: anywhere;
		hyphens: auto;
	}
	.title strong {
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.meta {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.25rem;
		font-size: var(--step--1);
		color: var(--ink-soft);
	}
	.price {
		font-weight: 700;
		color: var(--ink);
	}
</style>
