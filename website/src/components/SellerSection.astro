---
// "Verkaufen" in the profile (src/pages/[...lang]/account.astro): become a seller, submit pieces, see their status,
// the sales to ship (buyer's address, label, "sent") and the payouts. Data from /api/seller/ (functions/api/seller).
// Loads when the account page shows the profile (event "profile-shown").
import { url, type Lang } from '../i18n';
import { sellerTexts } from '../i18n/seller';
import { SHIPPING } from '../config';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const st = sellerTexts[lang];
---

<section class="block selling" id="selling" aria-labelledby="selling-title" data-seller-texts={JSON.stringify(st)} data-lang={lang} hidden>
	<h2 id="selling-title">{st.title}</h2>

	<div data-join hidden>
		<p>{st.intro}</p>
		<p class="small muted">{st.fees.replace('{shipping}', String(SHIPPING.price))}</p>
		<label class="check">
			<input type="checkbox" data-seller-terms />
			<span>{st.terms} <a href={url(lang, '/seller-terms/')} target="_blank" rel="noopener">{st.termsLink}</a></span>
		</label>
		<button type="button" class="btn" data-seller-join>{st.join}</button>
		<p class="status small" role="status" data-join-status></p>
	</div>

	<div data-seller hidden>
		<p class="small muted" data-next-rate></p>
		<p><a class="btn" href={url(lang, '/sell/new/')}>+ {st.submit}</a></p>
		<p class="iban-missing small" data-iban-missing hidden>{st.ibanMissing}</p>

		<h3>{st.mySales}</h3>
		<ul class="seller-list" data-sales></ul>

		<h3>{st.myPieces}</h3>
		<ul class="seller-list" data-subs></ul>

		<h3>{st.payout}</h3>
		<form class="payout stack" data-payout novalidate>
			<label><span>{st.iban}</span><input name="iban" autocomplete="off" spellcheck="false" maxlength="40" placeholder="CH93 0076 2011 6238 5295 7" required /></label>
			<label><span>{st.holder}</span><input name="accountHolder" autocomplete="name" maxlength="120" required /></label>
			<div class="foot"><button class="btn-line" type="submit">{st.save}</button></div>
			<p class="status small" role="status" data-payout-status></p>
		</form>
	</div>
</section>

<script>
	import type { SellerTexts } from '../i18n/seller';

	type Sale = {
		id: number;
		orderRef: string;
		productId: string;
		name: string;
		price: number;
		rate: number;
		commission: number;
		shipping: number;
		payout: number;
		status: 'to_ship' | 'shipped' | 'paid_out';
		shippedAt: number | null;
		paidOutAt: number | null;
		buyer: { name: string; line1: string; line2: string | null; postalCode: string; city: string; phone: string | null } | null;
	};
	type Sub = { id: number; status: 'pending' | 'approved' | 'rejected' | 'withdrawn'; brand: string; title: string; price: number; reason: string; productId: string | null };
	type Me = { seller: { iban: string; accountHolder: string } | null; nextRate: number; submissions: Sub[]; sales: Sale[] };

	const section = document.querySelector<HTMLElement>('#selling');
	if (section) {
		const box: HTMLElement = section;
		const t: SellerTexts = JSON.parse(box.dataset.sellerTexts!);
		const lang = box.dataset.lang!;
		const prefix = lang === 'de' ? '' : `/${lang}`;
		const $ = <T extends HTMLElement = HTMLElement>(sel: string) => box.querySelector<T>(sel)!;
		const chf = (n: number) => `CHF ${n.toFixed(2)}`;
		const day = (ms: number) => new Date(ms).toLocaleDateString({ de: 'de-CH', fr: 'fr-CH', it: 'it-CH', en: 'en-GB' }[lang] ?? 'de-CH');
		const fill = (text: string, v: Record<string, string>) => text.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');
		const message = (code: string) => (t.errors as Record<string, string>)[code] ?? t.errors.generic;
		const el = (tag: string, className = '', text?: string) => {
			const node = document.createElement(tag);
			if (className) node.className = className;
			if (text !== undefined) node.textContent = text;
			return node;
		};
		const call = async (path: string, method = 'GET', body?: unknown) => {
			const res = await fetch(`/api/seller/${path}`, {
				method,
				headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
				body: body === undefined ? undefined : JSON.stringify(body),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok) throw new Error(data.error ?? 'generic');
			return data;
		};

		function renderSale(s: Sale) {
			const li = el('li', `sale ${s.status}`);
			li.append(el('strong', '', s.name));
			if (s.status === 'to_ship') {
				li.append(el('p', 'small', t.saleToShip));
				if (s.buyer) {
					const address = el('p', 'address');
					address.textContent = [s.buyer.name, s.buyer.line1, s.buyer.line2, `${s.buyer.postalCode} ${s.buyer.city}`].filter(Boolean).join('\n');
					li.append(address);
				}
				const actions = el('div', 'actions');
				const label = el('a', 'btn-line', t.label) as HTMLAnchorElement;
				label.href = `/admin/label.html?seller=1&order=${s.orderRef}`;
				label.target = '_blank';
				const sent = el('button', 'btn', t.markShipped) as HTMLButtonElement;
				sent.type = 'button';
				sent.addEventListener('click', async () => {
					sent.disabled = true;
					try {
						await call(`sales/${s.id}/shipped`, 'POST', {});
						await load();
					} catch (error) {
						sent.disabled = false;
						alert(message((error as Error).message));
					}
				});
				actions.append(label, sent);
				li.append(actions);
			} else if (s.status === 'shipped' && s.shippedAt) {
				li.append(el('p', 'small', fill(t.saleShipped, { date: day(s.shippedAt), due: day(s.shippedAt + 14 * 86400_000) })));
			} else if (s.paidOutAt) li.append(el('p', 'small', fill(t.salePaid, { date: day(s.paidOutAt) })));
			li.append(
				el(
					'p',
					'small muted',
					fill(t.payoutLine, { price: chf(s.price), rate: String(Math.round(s.rate * 100)), commission: chf(s.commission), shipping: chf(s.shipping), payout: chf(s.payout) }),
				),
			);
			return li;
		}

		function renderSub(s: Sub) {
			const li = el('li', `sub ${s.status}`);
			const head = el('p');
			head.append(el('strong', '', `${s.brand} ${s.title}`), ` · ${chf(s.price)} · `, el('span', `tag ${s.status}`, t.status[s.status]));
			li.append(head);
			if (s.status === 'rejected' && s.reason) li.append(el('p', 'small muted', fill(t.reason, { reason: s.reason })));
			if (s.status === 'approved' && s.productId) {
				const a = el('a', 'small', `${t.toPiece} →`) as HTMLAnchorElement;
				a.href = `${prefix}/item/${s.productId}/`;
				li.append(a);
			}
			if (s.status === 'pending') {
				const withdraw = el('button', 'link small', t.withdraw) as HTMLButtonElement;
				withdraw.type = 'button';
				withdraw.addEventListener('click', async () => {
					withdraw.disabled = true;
					await call(`submissions/${s.id}`, 'DELETE').catch(() => {});
					await load();
				});
				li.append(withdraw);
			}
			return li;
		}

		async function load() {
			let me: Me;
			try {
				me = await call('me');
			} catch {
				box.hidden = true;
				return;
			}
			box.hidden = false;
			$('[data-join]').hidden = Boolean(me.seller);
			$('[data-seller]').hidden = !me.seller;
			if (!me.seller) return;
			$('[data-next-rate]').textContent = fill(t.nextRate, { rate: String(Math.round(me.nextRate * 100)) });
			$('[data-iban-missing]').hidden = Boolean(me.seller.iban);
			$('[data-sales]').replaceChildren(...(me.sales.length ? me.sales.map(renderSale) : [el('li', 'muted small', t.noSales)]));
			$('[data-subs]').replaceChildren(...(me.submissions.length ? me.submissions.map(renderSub) : [el('li', 'muted small', t.noPieces)]));
			const form = $<HTMLFormElement>('[data-payout]');
			if (document.activeElement?.closest('[data-payout]') !== form) {
				(form.elements.namedItem('iban') as HTMLInputElement).value = me.seller.iban;
				(form.elements.namedItem('accountHolder') as HTMLInputElement).value = me.seller.accountHolder;
			}
			if (location.hash === '#selling') box.scrollIntoView({ block: 'start' });
		}

		$('[data-seller-join]').addEventListener('click', async () => {
			const status = $('[data-join-status]');
			if (!$<HTMLInputElement>('[data-seller-terms]').checked) return (status.textContent = t.errors.terms);
			try {
				await call('join', 'POST', { acceptTerms: true });
				status.textContent = '';
				await load();
			} catch (error) {
				status.textContent = message((error as Error).message);
			}
		});

		$<HTMLFormElement>('[data-payout]').addEventListener('submit', async (event) => {
			event.preventDefault();
			const form = event.currentTarget as HTMLFormElement;
			const status = $('[data-payout-status]');
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			try {
				const result = await call('payout', 'PUT', data);
				(form.elements.namedItem('iban') as HTMLInputElement).value = result.iban;
				status.textContent = t.saved;
				$('[data-iban-missing]').hidden = true;
			} catch (error) {
				status.textContent = message((error as Error).message);
			}
		});

		window.addEventListener('profile-shown', load);
		window.addEventListener('profile-hidden', () => (box.hidden = true));
	}
</script>

<style>
	.selling h3 {
		margin: 1.5rem 0 0.5rem;
		font-size: var(--step-0, 1rem);
	}
	.selling[hidden],
	.selling [hidden] {
		display: none !important;
	}
	.seller-list {
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.seller-list :global(li.sale),
	.seller-list :global(li.sub) {
		padding: 0.8rem 1rem;
		border: 1px solid var(--line);
		background: var(--bg-raised);
	}
	.seller-list :global(li.sale.to_ship) {
		border: 2px solid var(--ink);
	}
	.seller-list :global(p) {
		margin: 0.3rem 0;
	}
	.seller-list :global(.address) {
		white-space: pre-line;
		font-weight: 600;
	}
	.seller-list :global(.actions) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.seller-list :global(.tag) {
		padding: 0.1em 0.6em;
		border-radius: 999px;
		background: var(--bg-sunken);
		font-size: 0.8em;
	}
	.seller-list :global(.tag.approved) {
		background: #dcfce7;
		color: #14532d;
	}
	.seller-list :global(.tag.rejected) {
		background: #fee2e2;
		color: #7f1d1d;
	}
	.iban-missing {
		padding: 0.6rem 0.9rem;
		background: #fef3c7;
	}
	/* The payout form and the outline buttons, styled here: the account page's form styles don't reach into this component. */
	.payout {
		display: grid;
		gap: 0.75rem;
		max-width: 28rem;
	}
	.payout label span {
		display: block;
		margin-bottom: 0.3rem;
		font-weight: 600;
		font-size: var(--step--1);
	}
	.payout input {
		width: 100%;
		padding: 0.6rem 0.75rem;
		border: 1.5px solid var(--line);
		background: var(--bg-raised);
		color: var(--ink);
		font: inherit;
	}
	.payout p {
		margin: 0;
	}
	.selling :global(.btn-line) {
		display: inline-flex;
		align-items: center;
		padding: 0.55em 1.2em;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
	}
	.selling .check {
		display: flex;
		gap: 0.5rem;
		align-items: flex-start;
		margin: 0.75rem 0;
	}
</style>
