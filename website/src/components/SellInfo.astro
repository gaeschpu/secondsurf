---
// Steps + "what we cover" + form, used by both sell pages.
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
import { useT, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	kind: 'stockist' | 'sellOnce';
	steps: string[];
	covers: string[];
	/** Short box with the deal (share, conditions). */
	terms: string;
}
const { lang, kind, steps, covers, terms } = Astro.props;
const t = useT(lang);
---

<section class="how">
	<h2>{t('sell.how')}</h2>
	<ol class="steps">
		{steps.map((s, i) => (
			<li class="card">
				<span class="num">{i + 1}</span>
				<p>{s}</p>
			</li>
		))}
	</ol>
</section>

<section class="cover">
	<h2>{t('sell.weCover')}</h2>
	<ul>
		{covers.map((c) => (
			<li><Icon name="wave" size={18} /> {c}</li>
		))}
	</ul>
	<p class="card terms">{terms} <span class="todo">TODO</span></p>
</section>

<div class="form">
	<InquiryForm lang={lang} kind={kind} title={t('sell.apply')} />
</div>

<style>
	section,
	.form {
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}
	h2 {
		margin-bottom: 1.25rem;
		text-transform: uppercase;
	}
	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
		gap: 1rem;
		padding: 0;
		list-style: none;
	}
	.steps li {
		padding: 1.25rem;
	}
	.num {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		margin-bottom: 0.75rem;
		border-radius: 50%;
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 700;
	}
	.cover ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 0.6rem 1.5rem;
		padding: 0;
		list-style: none;
	}
	.cover li {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
	}
	.cover li :global(svg) {
		flex: none;
		color: var(--accent);
		transform: translateY(0.2em);
	}
	.terms {
		margin-top: 1.5rem;
		padding: 1.25rem 1.5rem;
		border-left: 4px solid var(--sand);
	}
</style>
