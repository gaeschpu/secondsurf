---
import Base from '../../layouts/Base.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { langPaths, url, useT, type Lang } from '../../i18n';
import { SITE } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

const text = {
	de: {
		conditions: 'Wann eine Rückgabe möglich ist',
		items: ['Du hast das falsche Piece erhalten.', 'Das Piece wurde beim Versand beschädigt.', 'Das Piece entspricht nicht der Beschreibung.'],
		rules: 'Melde dich innert 14 Tagen nach Erhalt. Das Piece muss ungetragen und im erhaltenen Zustand sein. Ist der Fehler bei uns, übernehmen wir den Rückversand, sonst du. Du erhältst kein Geld zurück, sondern einen Gutschein im Wert des Kaufpreises. Weil jedes Piece ein Einzelstück ist, gibt es keinen Umtausch.',
		terms: 'Alle Details stehen in den',
	},
	fr: {
		conditions: 'Quand un retour est possible',
		items: ['Tu as reçu la mauvaise pièce.', 'La pièce a été endommagée pendant l’envoi.', 'La pièce ne correspond pas à la description.'],
		rules: 'Annonce-le dans les 14 jours après réception. La pièce doit être non portée et dans l’état reçu. Si l’erreur vient de nous, nous prenons le renvoi en charge, sinon il est à ta charge. Tu ne reçois pas d’argent, mais un bon d’une valeur égale au prix d’achat. Chaque pièce étant unique, il n’y a pas d’échange.',
		terms: 'Tous les détails figurent dans les',
	},
	it: {
		conditions: 'Quando è possibile un reso',
		items: ['Hai ricevuto il pezzo sbagliato.', 'Il pezzo è stato danneggiato durante la spedizione.', 'Il pezzo non corrisponde alla descrizione.'],
		rules: 'Segnalacelo entro 14 giorni dal ricevimento. Il pezzo non deve essere stato indossato e deve essere nello stato in cui l’hai ricevuto. Se l’errore è nostro, paghiamo noi la spedizione di ritorno, altrimenti la paghi tu. Non ricevi denaro, ma un buono del valore del prezzo d’acquisto. Ogni pezzo è unico, quindi non sono possibili cambi.',
		terms: 'Tutti i dettagli si trovano nelle',
	},
	en: {
		conditions: 'When a return is possible',
		items: ['You received the wrong piece.', 'The piece was damaged in shipping.', 'The piece doesn’t match the description.'],
		rules: 'Tell us within 14 days of receiving it. The piece must be unworn and in the condition you received it. If the mistake was ours, we pay for return shipping; otherwise you do. You don’t get money back, but a gift card worth the purchase price. Every piece is one of a kind, so there are no exchanges.',
		terms: 'All the details are in the',
	},
}[lang];
---

<Base lang={lang} title={t('returns.title')} description={t('returns.intro')}>
	<div class="container">
		<header class="page-head">
			<h1>{t('returns.title')}</h1>
			<p>{t('returns.intro')}</p>
		</header>
		<div class="prose">
			<h2>{text.conditions}</h2>
			<ul>
				{text.items.map((item) => <li>{item}</li>)}
			</ul>
			<p>{text.rules}</p>
			<p>{text.terms} <a href={url(lang, '/terms/')}>{t('legal.terms')}</a>.</p>
		</div>
		<div class="form">
			<InquiryForm lang={lang} kind="returns" title={t('returns.form')} />
			<p class="small muted fallback">{t('returns.orEmail')} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
		</div>
	</div>
</Base>

<style>
	.form {
		margin-top: 3rem;
	}
	.fallback {
		margin-top: 1.5rem;
	}
</style>
