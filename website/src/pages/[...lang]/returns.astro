---
import Base from '../../layouts/Base.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { langPaths, url, useT, type Lang } from '../../i18n';
import { SITE } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

const text = {
	de: {
		conditions: 'Wann eine Rückgabe möglich ist',
		items: ['Du hast das falsche Piece erhalten.', 'Das Piece wurde beim Versand beschädigt.', 'Das Piece entspricht nicht der Beschreibung.'],
		rules: 'Melde dich rasch, spätestens innert 14 Tagen nach Erhalt. Einen Mangel, der sich erst später zeigt, meldest du sofort nach der Entdeckung. Schick das Piece im Zustand zurück, in dem du es erhalten hast. Wir übernehmen den Rückversand und erstatten dir den Kaufpreis samt Versandkosten zurück, oder du erhältst auf Wunsch einen Gutschein im gleichen Wert. Weil jedes Piece ein Einzelstück ist, gibt es keinen Umtausch.',
		terms: 'Alle Details stehen in den',
	},
	fr: {
		conditions: 'Quand un retour est possible',
		items: ['Tu as reçu la mauvaise pièce.', 'La pièce a été endommagée pendant l’envoi.', 'La pièce ne correspond pas à la description.'],
		rules: 'Annonce-le rapidement, au plus tard dans les 14 jours après réception. Un défaut qui n’apparaît que plus tard doit nous être signalé dès sa découverte. Renvoie la pièce dans l’état où tu l’as reçue. Nous prenons le renvoi en charge et te remboursons le prix d’achat et les frais d’envoi, ou, si tu préfères, tu reçois un bon de la même valeur. Chaque pièce étant unique, il n’y a pas d’échange.',
		terms: 'Tous les détails figurent dans les',
	},
	it: {
		conditions: 'Quando è possibile un reso',
		items: ['Hai ricevuto il pezzo sbagliato.', 'Il pezzo è stato danneggiato durante la spedizione.', 'Il pezzo non corrisponde alla descrizione.'],
		rules: 'Segnalacelo subito, al più tardi entro 14 giorni dal ricevimento. Un difetto che si manifesta solo più tardi va segnalato subito dopo averlo scoperto. Rispedisci il pezzo nello stato in cui l’hai ricevuto. Paghiamo noi la spedizione di ritorno e ti rimborsiamo il prezzo d’acquisto e le spese di spedizione, oppure, se preferisci, ricevi un buono dello stesso valore. Ogni pezzo è unico, quindi non sono possibili cambi.',
		terms: 'Tutti i dettagli si trovano nelle',
	},
	en: {
		conditions: 'When a return is possible',
		items: ['You received the wrong piece.', 'The piece was damaged in shipping.', 'The piece doesn’t match the description.'],
		rules: 'Tell us quickly, at the latest within 14 days of receiving it. A defect that only shows up later must be reported as soon as you discover it. Send the piece back in the condition you received it. We pay for return shipping and refund the purchase price and shipping costs, or, if you prefer, you get a gift card of the same value. Every piece is one of a kind, so there are no exchanges.',
		terms: 'All the details are in the',
	},
}[lang];
---

<Base lang={lang} title={t('returns.title')} description={t('returns.intro')}>
	<div class="container">
		<header class="page-head">
			<h1>{t('returns.title')}</h1>
			<p>{t('returns.intro')}</p>
		</header>
		<div class="prose">
			<h2>{text.conditions}</h2>
			<ul>
				{text.items.map((item) => <li>{item}</li>)}
			</ul>
			<p>{text.rules}</p>
			<p>{text.terms} <a href={url(lang, '/terms/')}>{t('legal.terms')}</a>.</p>
		</div>
		<div class="form">
			<InquiryForm lang={lang} kind="returns" title={t('returns.form')} />
			<p class="small muted fallback">{t('returns.orEmail')} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
		</div>
	</div>
</Base>

<style>
	.form {
		margin-top: 3rem;
	}
	.fallback {
		margin-top: 1.5rem;
	}
</style>
