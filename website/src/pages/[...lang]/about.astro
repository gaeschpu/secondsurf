---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { l, langPaths, url, useT, type Lang } from '../../i18n';
import TEXTS from '../../settings/texts.json';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const paragraphs = l(TEXTS.aboutText, lang).split(/\n\s*\n/);
---

<Base lang={lang} title={t('about.title')} description={paragraphs[0]}>
	<div class="container">
		<header class="page-head">
			<p class="eyebrow">{t('about.title')}</p>
			<h1>{l(TEXTS.aboutTitle, lang)}</h1>
		</header>
		<div class="prose">
			{paragraphs.map((p) => <p>{p}</p>)}
		</div>
		<p class="actions">
			<a class="btn" href={url(lang, '/shop/')}>{t('nav.shopAll')} <Icon name="arrow" /></a>
			<a class="btn btn-ghost" href={url(lang, '/sell/stockist/')}>{t('nav.stockist')}</a>
		</p>
	</div>
</Base>

<style>
	.prose {
		font-size: var(--step-1);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.5rem;
	}
</style>
