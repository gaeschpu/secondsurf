---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { langPaths, useT, type Lang } from '../../i18n';
import { SITE, SOCIALS } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

// The address doesn't appear on this page's HTML: both parts are reversed and base64-encoded,
// and only put together in the browser after a click.
const encode = (s: string) => Buffer.from([...s].reverse().join('')).toString('base64');
const [emailUser, emailDomain] = SITE.email.split('@');
---

<Base lang={lang} title={t('contact.title')} description={t('contact.intro')}>
	<div class="container">
		<header class="page-head">
			<h1>{t('contact.title')}</h1>
			<p>{t('contact.intro')}</p>
		</header>

		<InquiryForm lang={lang} kind="contact" title={t('contact.form')} />

		<section class="email-section" aria-labelledby="email-title">
			<h2 id="email-title">{t('contact.orEmail')}</h2>
			<div class="card email-card">
				<Icon name="mail" size={28} />
				<div class="email-slot" data-u={encode(emailUser)} data-d={encode(emailDomain)}>
					<button type="button" class="btn btn-ghost reveal">{t('contact.showEmail')}</button>
				</div>
			</div>
		</section>

		<section class="social-section" aria-labelledby="social-title">
			<h2 id="social-title">{t('contact.instagram')}</h2>
			<p class="muted">{t('contact.instagramText')}</p>
			<ul>
				{
					SOCIALS.map((s) => (
						<li>
							<a class="card social" href={s.href} rel="noopener" target="_blank">
								<Icon name={s.icon} size={28} />
								<span>
									<strong>{s.handle}</strong>
									<span class="small muted">{s.label}</span>
								</span>
								<Icon name="arrow" size={18} class="go" />
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Base>

<script>
	const decode = (s: string) => [...atob(s)].reverse().join('');

	document.querySelectorAll<HTMLElement>('.email-slot').forEach((slot) => {
		slot.querySelector('.reveal')?.addEventListener('click', () => {
			const address = `${decode(slot.dataset.u!)}@${decode(slot.dataset.d!)}`;
			const link = document.createElement('a');
			link.href = `mailto:${address}`;
			link.textContent = address;
			link.className = 'address';
			slot.replaceChildren(link);
			link.focus();
		});
	});
</script>

<style>
	.email-card {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.5rem;
		color: var(--accent);
	}
	.email-slot :global(.address) {
		font-size: var(--step-1);
		font-weight: 600;
		word-break: break-all;
	}
	.email-section,
	.social-section {
		margin-top: 3rem;
	}
	h2 {
		margin-bottom: 1rem;
	}
	.social-section ul {
		margin-top: 1rem;
		padding: 0;
		list-style: none;
	}
	.social {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1.1rem 1.4rem;
		color: var(--accent);
		text-decoration: none;
	}
	.social > span {
		display: flex;
		flex-direction: column;
		color: var(--ink);
		line-height: 1.35;
	}
	.social:hover {
		border-color: var(--accent);
	}
	.social :global(.go) {
		margin-left: auto;
		color: var(--ink-soft);
	}
</style>
