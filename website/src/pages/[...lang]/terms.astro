// AGB, from the owner's document (raw-docs/legal forms/AGB_secondsurf.pdf, Stand 05.11.2026), in all four languages.
// German is the contract language (2.5); the other versions say so. Section 6 follows the returns page:
// only wrong, damaged or not-as-described pieces. Shipping figures come from src/settings/site.json.
import LegalPage from '../../components/LegalPage.astro';
import { chf, langPaths, url, useT, type Lang } from '../../i18n';
import { OWNER, SHIPPING, SITE } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const link = (href: string, label: string) => `<a href="${esc(href)}">${esc(label)}</a>`;
/** Fills {email}, {privacy}, {returns}, {price}, {free}, {owner} in a paragraph. */
const fill = (text: string) =>
	esc(text)
		.replace(/\{email\}/g, link(`mailto:${SITE.email}`, SITE.email))
		.replace(/\{privacy\}/g, link(url(lang, '/privacy/'), `secondsurf.ch${url(lang, '/privacy/')}`))
		.replace(/\{returns\}/g, link(url(lang, '/returns/'), t('returns.title')))
		.replace(/\{price\}/g, chf(SHIPPING.price))
		.replace(/\{free\}/g, chf(SHIPPING.freeFrom))
		.replace(/\{owner\}/g, esc(OWNER.name));

type Section = { title: string; paragraphs: (string | string[])[] };

