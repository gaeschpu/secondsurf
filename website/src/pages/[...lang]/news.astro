---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { htmlLang, l, langPaths, useT, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formatDate = new Intl.DateTimeFormat(htmlLang[lang], { dateStyle: 'long' });
---

<Base lang={lang} title={t('news.title')} description={t('news.intro')}>
	<div class="container">
		<header class="page-head">
			<h1>{t('news.title')}</h1>
			<p>{t('news.intro')}</p>
		</header>
		{news.length === 0 && <p class="muted">{t('news.empty')}</p>}
		{
			news.map((item) => (
				<article class="card news">
					<time class="small muted" datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate.format(item.data.date)}</time>
					<h2>{l(item.data.title, lang)}</h2>
					{l(item.data.text, lang).split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
				</article>
			))
		}
	</div>
</Base>

<style>
	.news {
		display: grid;
		gap: 0.6rem;
		padding: 1.25rem 1.5rem;
	}
	.news + .news {
		margin-top: 1rem;
	}
</style>
