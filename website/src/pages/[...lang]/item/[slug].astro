---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import WishButton from '../../../components/WishButton.astro';
import OfferForm from '../../../components/OfferForm.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { chf, l, langPaths, url, useT, type Lang } from '../../../i18n';
import { CATEGORIES, CHECKOUT, CONDITIONS, SITE } from '../../../config';
import type { Product } from '../../../lib/products';

export async function getStaticPaths() {
	const products = await getCollection('products', (p) => import.meta.env.DEV || !p.data.draft);
	return langPaths().flatMap(({ params, props }) =>
		products.map((product) => ({ params: { ...params, slug: product.id }, props: { ...props, product } })),
	);
}
const { lang, product } = Astro.props as { lang: Lang; product: Product };
const t = useT(lang);
const p = product.data;
const name = l(p.title, lang);
const category = CATEGORIES.find((c) => c.id === p.category)!;
const inquireHref = `${url(lang, '/contact/')}?item=${encodeURIComponent(`${p.brand} ${name} (${p.size}, ${chf(p.price)}) – ${product.id}`)}`;
const ogImage = p.photos[0] && (await getImage({ src: p.photos[0], width: 1200, format: 'jpeg' })).src;
// Stripe Checkout (functions/api/checkout.ts) when it's switched on in src/settings/site.json, unless the piece has its own buyUrl.
const checkout = CHECKOUT.enabled && !p.buyUrl;
---

<Base
	lang={lang}
	title={`${p.brand} ${name}`}
	description={l(p.description, lang) || `${p.brand} ${name}, ${t('shop.size')} ${p.size}, ${l(CONDITIONS[p.condition], lang)}, ${chf(p.price)}.`}
	image={ogImage}
>
	<JsonLd
		slot="head"
		data={{
			'@type': 'Product',
			name: `${p.brand} ${name}`,
			brand: { '@type': 'Brand', name: p.brand },
			category: l(category.label, lang),
			...(l(p.description, lang) && { description: l(p.description, lang) }),
			...(ogImage && { image: new URL(ogImage, SITE.url).href }),
			offers: {
				'@type': 'Offer',
				url: new URL(url(lang, `/item/${product.id}/`), SITE.url).href,
				priceCurrency: 'CHF',
				price: p.price,
				availability: `https://schema.org/${p.sold ? 'SoldOut' : 'InStock'}`,
				itemCondition: `https://schema.org/${p.condition === 'new' ? 'NewCondition' : 'UsedCondition'}`,
			},
		}}
	/>
	<div class="container-wide">
		<p class="crumbs small">
			<a href={url(lang, '/shop/')}>{t('nav.shopAll')}</a> / <a href={url(lang, `/shop/${category.id}/`)}>{l(category.label, lang)}</a>
		</p>
		<article class="item">
			<div class="photos" data-gallery>
				{
					p.photos.length > 0 ? (
						<>
							<div class="stage">
								<div class="track" data-track>
									{p.photos.map((photo, i) => (
										<Image
											src={photo}
											alt={i === 0 ? `${p.brand} ${name}` : ''}
											widths={[480, 900, 1400]}
											sizes="(max-width: 48rem) 100vw, 55vw"
											loading={i === 0 ? 'eager' : 'lazy'}
											class:list={['slide', { sold: p.sold }]}
										/>
									))}
								</div>
								{p.photos.length > 1 && (
									<>
										<button type="button" class="nav prev" data-step="-1" aria-label={t('shop.prevPhoto')} hidden>
											<Icon name="chevronLeft" size={22} />
										</button>
										<button type="button" class="nav next" data-step="1" aria-label={t('shop.nextPhoto')}>
											<Icon name="chevronRight" size={22} />
										</button>
										<span class="counter small" aria-hidden="true">
											<span data-current>1</span> / {p.photos.length}
										</span>
									</>
								)}
							</div>
							{p.photos.length > 1 && (
								<div class="thumbs">
									{p.photos.map((photo, i) => (
										<button type="button" class:list={['thumb', { on: i === 0 }]} data-index={i} aria-label={`${i + 1} / ${p.photos.length}`}>
											<Image src={photo} alt="" widths={[120, 240]} sizes="5rem" loading="lazy" />
										</button>
									))}
								</div>
							)}
						</>
					) : (
						<div class="placeholder" aria-hidden="true">
							<Icon name="shirt" size={64} />
						</div>
					)
				}
			</div>
			<div class="info">
				{p.draft && <p class="small"><span class="todo">DRAFT</span> {t('shop.example')}</p>}
				<p class="eyebrow">{p.brand}</p>
				<h1>{name}{p.staffPick && ' ★'}</h1>
				<p class="price">{chf(p.price)}</p>
				<dl>
					<dt>{t('shop.size')}</dt>
					<dd>{p.size}{p.sizeNote && ` · ${p.sizeNote}`}</dd>
					<dt>{t('shop.condition')}</dt>
					<dd>{l(CONDITIONS[p.condition], lang)}</dd>
					{p.measurements && (
						<>
							<dt>{t('shop.measurements')}</dt>
							<dd>{p.measurements}</dd>
						</>
					)}
				</dl>
				{p.description && <p class="desc">{l(p.description, lang)}</p>}
				{
					p.sold ? (
						<p class="sold-note">{t('shop.sold')}</p>
					) : checkout ? (
						<>
							<p id="reserved" class="checkout-msg small" role="status">{t('checkout.reserved')}</p>
							<p id="checkout-error" class="checkout-msg small" role="status">{t('checkout.error')}</p>
							<form class="actions" method="post" action="/api/checkout">
								<input type="hidden" name="id" value={product.id} />
								<input type="hidden" name="lang" value={lang} />
								<button class="btn big" type="submit">
									{t('shop.buy')} <Icon name="arrow" />
								</button>
							</form>
							<p class="small muted">{t('checkout.note')}</p>
						</>
					) : p.buyUrl ? (
						<p class="actions">
							<a class="btn big" href={p.buyUrl} rel="noopener">
								{t('shop.buy')} <Icon name="arrow" />
							</a>
						</p>
					) : (
						<>
							<p class="actions">
								<a class="btn big" href={inquireHref}>
									{t('shop.inquire')} <Icon name="arrow" />
								</a>
							</p>
							<p class="small muted">{t('shop.inquireNote')}</p>
						</>
					)
				}
				{!p.sold && <p class="wish-row"><WishButton lang={lang} id={product.id} withLabel /></p>}
				{!p.sold && <OfferForm lang={lang} id={product.id} price={p.price} />}
				<p class="back small"><a href={url(lang, '/shop/')}>← {t('shop.back')}</a></p>
			</div>
		</article>
	</div>
</Base>

<script>
	// Product page gallery: arrows, thumbnails and the counter all follow the scroll position, so swiping works too.
	for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
		const track = gallery.querySelector<HTMLElement>('[data-track]');
		const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('.thumb')];
		const prev = gallery.querySelector<HTMLButtonElement>('.nav.prev');
		const next = gallery.querySelector<HTMLButtonElement>('.nav.next');
		const current = gallery.querySelector<HTMLElement>('[data-current]');
		if (!track || thumbs.length < 2) continue;
		const count = thumbs.length;
		const index = () => Math.round(track.scrollLeft / track.clientWidth);
		const go = (i: number) => track.scrollTo({ left: Math.min(count - 1, Math.max(0, i)) * track.clientWidth, behavior: 'smooth' });
		const update = () => {
			const i = index();
			thumbs.forEach((thumb, n) => thumb.classList.toggle('on', n === i));
			// Keep the active thumbnail visible by scrolling only the thumbnail row, never the page.
			const row = thumbs[i]?.parentElement;
			if (row && thumbs[i]) {
				const t = thumbs[i];
				if (t.offsetLeft < row.scrollLeft) row.scrollLeft = t.offsetLeft;
				else if (t.offsetLeft + t.offsetWidth > row.scrollLeft + row.clientWidth) row.scrollLeft = t.offsetLeft + t.offsetWidth - row.clientWidth;
			}
			if (prev) prev.hidden = i === 0;
			if (next) next.hidden = i === count - 1;
			if (current) current.textContent = String(i + 1);
		};
		prev?.addEventListener('click', () => go(index() - 1));
		next?.addEventListener('click', () => go(index() + 1));
		thumbs.forEach((thumb, n) => thumb.addEventListener('click', () => go(n)));
		track.addEventListener('scroll', update, { passive: true });
		gallery.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') go(index() - 1);
			if (event.key === 'ArrowRight') go(index() + 1);
		});
	}
</script>

<style>
	.crumbs {
		padding-top: 1.5rem;
		color: var(--ink-soft);
	}
	.item {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: clamp(1.5rem, 5vw, 3.5rem);
		margin-top: 1.25rem;
		align-items: start;
	}
	.photos {
		display: grid;
		gap: 0.75rem;
		min-width: 0;
	}
	/* Big photo: swipe on phones, arrows or thumbnails on computers. */
	.stage {
		position: relative;
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-sunken);
	}
	.track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.photos :global(img.slide),
	.placeholder {
		flex: 0 0 100%;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		border-radius: var(--radius-sm);
		background: var(--bg-sunken);
	}
	.photos :global(img.slide) {
		border-radius: 0;
	}
	.photos :global(img.sold) {
		filter: grayscale(1);
	}
	.nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.92);
		color: var(--ink);
		box-shadow: 0 1px 6px rgba(0, 0, 0, 0.2);
		cursor: pointer;
	}
	.nav[hidden] {
		display: none;
	}
	.prev {
		left: 0.75rem;
	}
	.next {
		right: 0.75rem;
	}
	.counter {
		position: absolute;
		bottom: 0.75rem;
		right: 0.75rem;
		padding: 0.15em 0.65em;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.55);
		color: #fff;
	}
	.thumbs {
		position: relative;
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scrollbar-width: thin;
	}
	.thumb {
		flex: 0 0 4.5rem;
		padding: 0;
		border: 2px solid transparent;
		border-radius: var(--radius-sm);
		background: none;
		cursor: pointer;
		opacity: 0.6;
		transition: opacity 0.2s, border-color 0.2s;
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: calc(var(--radius-sm) - 2px);
	}
	.thumb:hover,
	.thumb.on {
		opacity: 1;
	}
	.thumb.on {
		border-color: var(--ink);
	}
	/* Phones: swipe instead of arrows. */
	@media (hover: none) {
		.nav {
			display: none;
		}
	}
	.placeholder {
		display: grid;
		place-items: center;
		background: var(--sand-tint);
		color: var(--sand);
	}
	.info {
		position: sticky;
		top: 6rem;
	}
	h1 {
		margin-top: 0.4rem;
		font-size: var(--step-3);
		text-transform: uppercase;
	}
	.price {
		margin-top: 0.75rem;
		font-size: var(--step-2);
		font-weight: 700;
	}
	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.4rem 1.25rem;
		margin-top: 1.5rem;
		padding-block: 1rem;
		border-block: 1px solid var(--line);
	}
	dt {
		font-weight: 700;
		font-size: var(--step--1);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.desc {
		margin-top: 1.25rem;
	}
	.actions {
		margin-top: 1.75rem;
		margin-bottom: 0.6rem;
	}
	.btn.big {
		padding: 0.9em 1.6em;
		font-size: var(--step-0);
	}
	.sold-note {
		margin-top: 1.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-soft);
	}
	.wish-row {
		margin-top: 1rem;
	}
	/* Shown when the checkout sends the customer back with #reserved or #checkout-error. */
	.checkout-msg {
		display: none;
		margin-top: 1.5rem;
		padding: 0.75rem 1rem;
		border-left: 3px solid var(--accent, currentColor);
		background: var(--surface-alt, rgba(0, 0, 0, 0.04));
	}
	.checkout-msg:target {
		display: block;
		scroll-margin-top: 6rem;
	}
	.back {
		margin-top: 2rem;
	}
	@media (max-width: 48rem) {
		.item {
			grid-template-columns: 1fr;
		}
		.info {
			position: static;
		}
	}
</style>
