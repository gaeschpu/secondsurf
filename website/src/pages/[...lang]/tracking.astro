---
// /tracking/?n=<number>: the buyer's parcel (link in "Dein Paket ist unterwegs", functions/_lib/orders.ts). Shows the
// Swiss Post tracking number as a big Code 128 barcode, so it can be scanned into the Post-App (from another screen or a
// printout), a copy button, and the Swiss Post tracking link. Nothing is looked up: the number comes from the link.
import Base from '../../layouts/Base.astro';
import { langPaths, url, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = {
	de: {
		title: 'Dein Paket',
		intro: 'Deine Sendungsnummer bei der Schweizerischen Post:',
		copy: 'Nummer kopieren',
		copied: 'Kopiert',
		track: 'Bei der Post verfolgen',
		app: 'In die Post-App übernehmen',
		steps: ['Öffne die Post-App und geh zu «Sendungen».', 'Tippe auf «+» bzw. «Sendung hinzufügen».', 'Scanne den Strichcode oben (z. B. auf dem Computer geöffnet) oder füge die kopierte Nummer ein.'],
		missing: 'Dieser Link enthält keine gültige Sendungsnummer.',
	},
	fr: {
		title: 'Ton colis',
		intro: 'Ton numéro d’envoi chez La Poste Suisse :',
		copy: 'Copier le numéro',
		copied: 'Copié',
		track: 'Suivre chez La Poste',
		app: 'Ajouter à l’app de La Poste',
		steps: ['Ouvre l’app de La Poste et va dans « Envois ».', 'Touche « + » ou « Ajouter un envoi ».', 'Scanne le code-barres ci-dessus (p. ex. ouvert sur l’ordinateur) ou colle le numéro copié.'],
		missing: 'Ce lien ne contient pas de numéro d’envoi valable.',
	},
	it: {
		title: 'Il tuo pacco',
		intro: 'Il tuo numero d’invio presso la Posta Svizzera:',
		copy: 'Copia il numero',
		copied: 'Copiato',
		track: 'Segui presso la Posta',
		app: 'Aggiungi all’app della Posta',
		steps: ['Apri l’app della Posta e vai su «Invii».', 'Tocca «+» o «Aggiungi invio».', 'Scansiona il codice a barre qui sopra (p. es. aperto sul computer) o incolla il numero copiato.'],
		missing: 'Questo link non contiene un numero d’invio valido.',
	},
	en: {
		title: 'Your parcel',
		intro: 'Your Swiss Post tracking number:',
		copy: 'Copy number',
		copied: 'Copied',
		track: 'Track with Swiss Post',
		app: 'Add it to the Swiss Post app',
		steps: ['Open the Swiss Post app and go to "Consignments".', 'Tap "+" or "Add consignment".', 'Scan the barcode above (e.g. opened on your computer) or paste the copied number.'],
		missing: 'This link has no valid tracking number.',
	},
}[lang];
---

<Base lang={lang} title={t.title} description={t.title} noindex>
	<div class="container page-head tracking-page" data-copied={t.copied}>
		<h1>{t.title}</h1>
		<div data-found hidden>
			<p>{t.intro}</p>
			<p class="number" data-number></p>
			<div class="barcode" data-barcode></div>
			<div class="actions">
				<button type="button" class="btn" data-copy>{t.copy}</button>
				<a class="btn-line" data-post target="_blank" rel="noopener">{t.track} →</a>
			</div>
			<h2>{t.app}</h2>
			<ol>
				{t.steps.map((step) => <li>{step}</li>)}
			</ol>
		</div>
		<p data-missing hidden>{t.missing}</p>
		<p class="small"><a href={url(lang, '/shop/')}>secondsurf →</a></p>
	</div>
</Base>

<script>
	// Code 128 (B for letters, C for an even number of digits, as Swiss Post's 18-digit numbers): bar/space widths per value.
	const PATTERNS =
		'212222 222122 222221 121223 121322 131222 122213 122312 132212 221213 221312 231212 112232 122132 122231 113222 123122 123221 223211 221132 221231 213212 223112 312131 311222 321122 321221 312212 322112 322211 212123 212321 232121 111323 131123 131321 112313 132113 132311 211313 231113 231311 112133 112331 132131 113123 113321 133121 313121 211331 231131 213113 213311 213131 311123 311321 331121 312113 312311 332111 314111 221411 431111 111224 111422 121124 121421 141122 141221 112214 112412 122114 122411 142112 142211 241211 221114 413111 241112 134111 111242 121142 121241 114212 124112 124211 411212 421112 421211 212141 214121 412121 111143 111341 131141 114113 114311 411113 411311 113141 114131 311141 411131 211412 211214 211232 2331112'.split(' ');

	function code128(text: string) {
		const digits = /^(\d\d)+$/.test(text);
		const values = digits ? [105, ...text.match(/\d\d/g)!.map(Number)] : [104, ...[...text].map((c) => c.charCodeAt(0) - 32)];
		const check = values.reduce((sum, v, i) => sum + v * (i || 1), 0) % 103;
		return [...values, check, 106].map((v) => PATTERNS[v]).join('');
	}

	function svg(text: string) {
		const widths = code128(text);
		const quiet = 10;
		let x = quiet;
		let bars = '';
		[...widths].forEach((w, i) => {
			const width = Number(w);
			if (i % 2 === 0) bars += `<rect x="${x}" y="0" width="${width}" height="60"/>`;
			x += width;
		});
		return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${x + quiet} 60" preserveAspectRatio="none" role="img" aria-label="${text}"><rect width="100%" height="100%" fill="#fff"/><g fill="#000">${bars}</g></svg>`;
	}

	const page = document.querySelector<HTMLElement>('.tracking-page')!;
	const raw = (new URLSearchParams(location.search).get('n') ?? '').toUpperCase().replace(/[^0-9A-Z]/g, '');
	const valid = /^\d{18}$/.test(raw) || /^[A-Z]{2}\d{9}[A-Z]{2}$/.test(raw);
	page.querySelector<HTMLElement>(valid ? '[data-found]' : '[data-missing]')!.hidden = false;
	if (valid) {
		const pretty = /^\d{18}$/.test(raw) ? `${raw.slice(0, 2)}.${raw.slice(2, 4)}.${raw.slice(4, 10)}.${raw.slice(10)}` : raw;
		page.querySelector('[data-number]')!.textContent = pretty;
		page.querySelector('[data-barcode]')!.innerHTML = svg(raw);
		page.querySelector<HTMLAnchorElement>('[data-post]')!.href = `https://www.post.ch/swisspost-tracking?formattedParcelCodes=${raw}`;
		const copy = page.querySelector<HTMLButtonElement>('[data-copy]')!;
		copy.addEventListener('click', async () => {
			await navigator.clipboard.writeText(raw).catch(() => {});
			copy.textContent = page.dataset.copied!;
		});
	}
</script>

<style>
	.tracking-page {
		max-width: 40rem;
		min-height: 50vh;
	}
	[data-found][hidden],
	[data-missing][hidden] {
		display: none;
	}
	.number {
		font-size: var(--step-2, 1.6rem);
		font-weight: 800;
		letter-spacing: 0.03em;
		font-variant-numeric: tabular-nums;
	}
	.barcode {
		padding: 1rem;
		background: #fff;
		border: 1px solid var(--line);
	}
	.barcode :global(svg) {
		display: block;
		width: 100%;
		height: 7rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.25rem 0 2rem;
	}
	.btn-line {
		display: inline-flex;
		align-items: center;
		padding: 0.6em 1.3em;
		border: 1.5px solid var(--ink);
		border-radius: 999px;
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
	}
	ol {
		padding-left: 1.2rem;
	}
	li {
		margin: 0.4rem 0;
	}
</style>
