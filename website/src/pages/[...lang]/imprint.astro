---
import LegalPage from '../../components/LegalPage.astro';
import { langPaths, useT, type Lang } from '../../i18n';
import { OWNER, SITE } from '../../config';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

const text = {
	de: { description: 'Impressum von secondsurf: Betreiber und Kontakt.', operator: 'Betreiber', owner: 'Inhaber', address: 'Adresse', contact: 'Kontakt', vat: 'Mehrwertsteuer', notVat: 'Nicht MWST-pflichtig.', uid: 'UID', missing: 'Kontaktadresse fehlt noch (Pflichtangabe nach Art. 3 Abs. 1 lit. s UWG).' },
	fr: { description: 'Mentions légales de secondsurf : exploitant et contact.', operator: 'Exploitant', owner: 'Propriétaire', address: 'Adresse', contact: 'Contact', vat: 'TVA', notVat: 'Non assujetti à la TVA.', uid: 'IDE', missing: 'L’adresse de contact manque encore (obligatoire selon l’art. 3 al. 1 let. s LCD).' },
	en: { description: 'Imprint of secondsurf: operator and contact.', operator: 'Operator', owner: 'Owner', address: 'Address', contact: 'Contact', vat: 'VAT', notVat: 'Not registered for VAT.', uid: 'UID', missing: 'The contact address is still missing (required by Art. 3 para. 1 let. s UCA).' },
}[lang];
---

<LegalPage lang={lang} title={t('legal.imprint')} description={text.description}>
	<h2>{text.operator}</h2>
	<p>
		{SITE.name}<br />
		{OWNER.legalForm}<br />
		{text.owner}: {OWNER.name}
	</p>
	<h2>{text.address}</h2>
	{OWNER.address.length > 0 ? <p set:html={OWNER.address.map((line) => line.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br />')} /> : <p><span class="todo">TODO</span> {text.missing}</p>}
	<h2>{text.contact}</h2>
	<p>
		<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
		{SITE.phone && <><br />{SITE.phone}</>}
	</p>
	<h2>{text.vat}</h2>
	<p>{text.notVat}{OWNER.uid && ` ${text.uid}: ${OWNER.uid}`}</p>
</LegalPage>
