---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
---

<Base lang="de" title={ui.de['404.title']} alternates={{}} noindex>
	<div class="container page-head notfound">
		<p class="eyebrow">404</p>
		<h1>{ui.de['404.title']}</h1>
		<p>{ui.de['404.text']} <a href="/">{ui.de['404.home']}</a></p>
		<p lang="fr-CH">{ui.fr['404.text']} <a href="/fr/">{ui.fr['404.home']}</a></p>
		<p lang="en">{ui.en['404.text']} <a href="/en/">{ui.en['404.home']}</a></p>
	</div>
</Base>

<style>
	.notfound {
		min-height: 50vh;
	}
</style>
